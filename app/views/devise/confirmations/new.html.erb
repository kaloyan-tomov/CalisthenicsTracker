<div class="w-full max-w-md bg-white border border-gray-200 rounded-xl p-6 shadow-lg">
  <h1 class="text-2xl font-bold mb-1 text-gray-900">Resend confirmation email</h1>
  <p class="text-sm text-gray-500 mb-6">
    Enter the email you used when registering. We'll send you a new confirmation link.
  </p>

  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
    <% if resource.errors.any? %>
      <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true %>
    </div>

    <%= f.submit "Send confirmation email",
          class: "w-full bg-blue-600 text-white py-2.5 px-4 rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
  <% end %>

  <div class="mt-6 pt-6 border-t border-gray-200 flex flex-col gap-2">
    <%= link_to "Back to login",
          login_path,
          class: "block w-full text-center px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium text-sm transition-colors" %>
    <%= link_to "Create a new account",
          register_path,
          class: "block w-full text-center text-sm text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
  </div>
</div>
