<% if total_pages > 1 %>
  <nav class="flex items-center justify-center gap-2 mt-6 mb-4" aria-label="Pagination">
    <% if page > 1 %>
      <%= link_to "← Prev",
                  url_for(request.query_parameters.merge(page: page - 1)),
                  class: "px-3 py-1 rounded bg-gray-200 hover:bg-gray-300 text-sm" %>
    <% else %>
      <span class="px-3 py-1 rounded bg-gray-100 text-gray-400 text-sm cursor-not-allowed">← Prev</span>
    <% end %>

    <span class="text-sm text-gray-600">
      Page <strong><%= page %></strong> of <%= total_pages %>
    </span>

    <% if page < total_pages %>
      <%= link_to "Next →",
                  url_for(request.query_parameters.merge(page: page + 1)),
                  class: "px-3 py-1 rounded bg-gray-200 hover:bg-gray-300 text-sm" %>
    <% else %>
      <span class="px-3 py-1 rounded bg-gray-100 text-gray-400 text-sm cursor-not-allowed">Next →</span>
    <% end %>
  </nav>
<% end %>
