<div class="w-full max-w-md bg-white border border-gray-200 rounded-xl p-6 shadow-lg">
  <h1 class="text-2xl font-bold mb-1 text-gray-900">Create Account</h1>
  <p class="text-sm text-gray-500 mb-6">
    You'll receive a confirmation email before you can sign in.
  </p>

  <%= form_with model: @user, url: "/register" do |f| %>
    <div class="mb-4">
      <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "username" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "email" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "new-password" %>
      <p class="text-sm text-gray-500 mt-1">
        At least 6 characters, with uppercase, lowercase, and a number.
      </p>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, "Confirm password",
            class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "new-password" %>
    </div>

    <%= f.submit "Create Account",
          class: "w-full bg-green-600 text-white py-2.5 px-4 rounded-lg hover:bg-green-700 font-semibold cursor-pointer" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600">
    Already have an account?
    <%= link_to "Log in",
          login_path,
          class: "text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
  </p>
</div>
