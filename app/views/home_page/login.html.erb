<div class="w-full max-w-md bg-white border border-gray-200 rounded-xl p-6 shadow-lg">
  <h1 class="text-2xl font-bold mb-1 text-gray-900">Login</h1>
  <p class="text-sm text-gray-500 mb-6">Sign in with your username, email, and password.</p>

  <%= form_with url: user_session_path, scope: :user do |f| %>
    <div class="mb-4">
      <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "username" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "email" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password,
            class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none",
            required: true,
            autocomplete: "current-password" %>
    </div>

    <%= f.submit "Log In",
          class: "w-full bg-blue-600 text-white py-2.5 px-4 rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
  <% end %>

  <div class="mt-6 pt-6 border-t border-gray-200">
    <p class="text-sm text-gray-600 text-center mb-3">
      Haven't confirmed your email yet?
    </p>
    <%= link_to "Resend confirmation email",
          new_user_confirmation_path,
          class: "block w-full text-center px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium text-sm transition-colors" %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-600">
    Don't have an account?
    <%= link_to "Create one",
          register_path,
          class: "text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
  </p>
</div>
