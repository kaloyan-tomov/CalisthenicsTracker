<div class="w-full max-w-xl bg-white border border-gray-200 rounded-xl p-6 shadow-lg">
  <h1 class="text-2xl font-bold mb-1 text-gray-900">New Post</h1>
  <p class="text-sm text-gray-500 mb-6">Share your attempt with photos or video.</p>

  <%= form_with model: @post do |f| %>
    <div class="mb-4">
      <%= f.label :skill_ids, "Skills shown in this post",
            class: "block text-sm font-medium text-gray-700 mb-1" %>

      <%= f.collection_select :skill_ids,
            @skills,
            :id,
            :name,
            {},
            { multiple: true, class: "w-full border border-gray-300 rounded-lg p-2 h-40 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" } %>

      <p class="text-sm text-gray-500 mt-1">
        Hold Ctrl (or Cmd) to select multiple skills.
      </p>
    </div>

    <div class="mb-4">
      <%= f.label :content, "Notes about the attempt",
            class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :content,
            rows: 5,
            placeholder: "How did it go? Any tips or progress notes...",
            class: "w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
    </div>

    <div class="mb-6" data-controller="file-input">
      <%= f.label :media, "Photos or video",
            class: "block text-sm font-medium text-gray-700 mb-2" %>

      <%= f.file_field :media,
            multiple: true,
            accept: "image/*,video/*",
            class: "hidden",
            data: {
              file_input_target: "input",
              action: "change->file-input#update"
            } %>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button"
                data-action="click->file-input#browse"
                class="px-4 py-2 rounded-lg bg-gray-100 border border-gray-300 text-gray-700 hover:bg-gray-200 font-medium text-sm transition-colors">
          Browse files
        </button>
        <span data-file-input-target="summary" class="text-sm text-gray-500">
          No files selected
        </span>
      </div>

      <p data-file-input-target="list" class="text-sm text-gray-500 mt-2 break-all"></p>
      <p class="text-sm text-gray-500 mt-1">Images or video, up to 50 MB each.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= f.submit "Post",
            class: "bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
      <%= link_to "Back",
            posts_path,
            class: "px-4 py-2.5 rounded-lg bg-gray-100 border border-gray-300 hover:bg-gray-200 font-medium text-gray-700" %>
    </div>
  <% end %>
</div>
