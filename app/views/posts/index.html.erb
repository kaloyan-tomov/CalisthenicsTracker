<div class="w-full max-w-2xl">
  <div class="flex flex-wrap gap-3 mb-6 items-center">
    <%= link_to "➕ New Post",
          new_post_path,
          class: "px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700 font-medium" %>

    <div class="ml-auto">
      <%= form_with url: posts_path, method: :get, local: true do |f| %>
        <div class="flex gap-2 items-center">
          <%= f.label :skill_id, "Filter by skill:",
                class: "text-sm text-gray-600" %>

          <%= f.select :skill_id,
                options_from_collection_for_select(@skills, :id, :name, params[:skill_id]),
                { include_blank: "All skills" },
                class: "border rounded p-2" %>

          <%= f.submit "Apply",
                class: "px-3 py-2 rounded bg-gray-200 hover:bg-gray-300 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="text-sm text-gray-600 mb-4">
    Showing <%= @posts.size %> of <%= @total_count %> posts
    <% if @selected_skill %> · filtered by <strong><%= @selected_skill.name %></strong><% end %>
  </div>

  <div id="posts" class="flex flex-col items-center">
    <% @posts.each do |post| %>
      <article class="post-card">
        <header class="flex justify-between items-baseline mb-2">
          <strong><%= post.user.username %></strong>
          <small class="text-gray-500">
            <%= time_ago_in_words(post.created_at) %> ago
          </small>
        </header>

        <% if post.skills.any? %>
          <div class="mb-2 flex flex-wrap gap-2">
            <% post.skills.each do |skill| %>
              <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700">
                <%= skill.name %>
              </span>
            <% end %>
          </div>
        <% end %>

        <p class="post-card__content mb-3 text-gray-800">
          <%= truncate(strip_tags(post.content), length: 280) %>
        </p>

        <% if post.media.attached? && (file = post.media.first) %>
          <% if file.image? %>
            <%= image_tag file,
                  class: "post-card__media mb-3",
                  loading: "lazy" %>
          <% elsif file.video? %>
            <%= video_tag file,
                  controls: true,
                  class: "post-card__media mb-3" %>
          <% end %>
          <% if post.media.size > 1 %>
            <div class="text-xs text-gray-500 mb-2">
              + <%= post.media.size - 1 %> more attachment<%= "s" if post.media.size > 2 %>
            </div>
          <% end %>
        <% end %>

        <footer class="flex justify-between items-center mt-3">
          <div class="flex items-center gap-3 text-sm text-gray-600">
            <span>💬 <%= post.comments.size %></span>
            <% if post.average_rating %>
              <span>⭐ <%= post.average_rating %>/5</span>
            <% end %>
          </div>

          <div class="flex gap-2 items-center">
            <%= link_to "Open",
                  post_path(post),
                  class: "inline-block px-3 py-1 rounded bg-indigo-100 text-indigo-700 hover:bg-indigo-200 text-sm font-medium" %>

            <% if current_user.admin? || post.user == current_user %>
              <%= button_to "Delete",
                    post_path(post),
                    method: :delete,
                    form: { data: { turbo_confirm: "Are you sure?" } },
                    class: "text-red-600 text-sm" %>
            <% end %>
          </div>
        </footer>
      </article>
    <% end %>
  </div>

  <%= render "shared/pagination", page: @page, total_pages: @total_pages %>
</div>
